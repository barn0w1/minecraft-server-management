# Non-secret production settings for AlmaLinux 10.
RUST_LOG=mcserver_control_plane=info,mcserver_protocol=info

MCSERVER_CONTROL_PLANE_SOCKET=/run/mcserver/control-plane.sock
MCSERVER_CONTROL_PLANE_DATABASE_URL=sqlite:///var/lib/mcserver/control-plane.db?mode=rwc
MCSERVER_CONTROL_PLANE_SOCKET_MODE=0660
MCSERVER_CONTROL_PLANE_AGENT_LISTEN_ADDRESS=127.0.0.1:39001
MCSERVER_CONTROL_PLANE_REAP_ORPHANS_ON_START=false
MCSERVER_CONTROL_PLANE_RECONCILE_INTERVAL_SECONDS=30
MCSERVER_CONTROL_PLANE_RECONCILE_RETRY_SECONDS=5
MCSERVER_CONTROL_PLANE_AGENT_COMMAND_TIMEOUT_SECONDS=900
MCSERVER_CONTROL_PLANE_SHUTDOWN_TIMEOUT_SECONDS=20

MCSERVER_CONTROL_PLANE_REMOTE_AGENT_LISTEN_ADDRESS=0.0.0.0:443
MCSERVER_CONTROL_PLANE_REMOTE_AGENT_PUBLIC_ADDRESS=agent.mcserver.hss-science.org:443
MCSERVER_CONTROL_PLANE_REMOTE_AGENT_TLS_SERVER_NAME=agent.mcserver.hss-science.org
MCSERVER_CONTROL_PLANE_REMOTE_AGENT_TLS_CERTIFICATE=/etc/mcserver/pki/remote-tls-fullchain.pem
MCSERVER_CONTROL_PLANE_REMOTE_AGENT_TLS_CA_CERTIFICATE=/etc/mcserver/pki/remote-tls-root-ca.pem
MCSERVER_CONTROL_PLANE_AGENT_CLIENT_CA_CERTIFICATE=/etc/mcserver/pki/agent-client-ca.pem
MCSERVER_CONTROL_PLANE_AGENT_CERTIFICATE_WORK_DIRECTORY=/run/mcserver/agent-pki
MCSERVER_CONTROL_PLANE_AGENT_CERTIFICATE_VALIDITY_SECONDS=172800
MCSERVER_CONTROL_PLANE_AGENT_TRUST_DOMAIN=hss-science.org
MCSERVER_CONTROL_PLANE_OPENSSL_BINARY=/usr/bin/openssl

# Pin these to one immutable GitHub Release asset and its SHA-256 digest.
MCSERVER_CONTROL_PLANE_NODE_AGENT_DOWNLOAD_URL=https://github.com/barn0w1/minecraft-server-management/releases/download/v0.1.0/mcserver-node-agent-v0.1.0-x86_64-unknown-linux-musl
MCSERVER_CONTROL_PLANE_NODE_AGENT_SHA256=REPLACE_WITH_64_HEX_CHARACTERS

MCSERVER_AKAMAI_API_BASE_URL=https://api.linode.com/v4
MCSERVER_AKAMAI_AUTHORIZED_KEYS_FILE=/etc/mcserver/authorized_keys
MCSERVER_AKAMAI_SCOPE=production
MCSERVER_AKAMAI_REQUEST_TIMEOUT_SECONDS=30
MCSERVER_AKAMAI_REAP_ORPHANS_ON_START=false
MCSERVER_AKAMAI_LIVE_ENABLED=false
MCSERVER_AKAMAI_REGION=jp-tyo-3
MCSERVER_AKAMAI_IMAGE=linode/debian13
MCSERVER_AKAMAI_FIREWALL_ID=REPLACE_WITH_EXISTING_FIREWALL_ID
MCSERVER_AKAMAI_ALLOWED_INSTANCE_TYPES=g6-nanode-1
MCSERVER_AKAMAI_MAX_ACTIVE_INSTANCES=1
MCSERVER_AKAMAI_MAX_INSTANCE_LIFETIME_SECONDS=43200

# Cloudflare R2 Temporary Credentials API. The parent access key ID identifies
# the parent R2 API credential; its secret key is never configured here.
MCSERVER_R2_API_BASE_URL=https://api.cloudflare.com/client/v4
MCSERVER_R2_ACCOUNT_ID=REPLACE_WITH_32_HEX_ACCOUNT_ID
MCSERVER_R2_PARENT_ACCESS_KEY_ID=REPLACE_WITH_PARENT_R2_ACCESS_KEY_ID
MCSERVER_R2_BUCKET=REPLACE_WITH_DEDICATED_BUCKET
MCSERVER_R2_TEMPORARY_CREDENTIAL_TTL_SECONDS=46800
MCSERVER_R2_REQUEST_TIMEOUT_SECONDS=30
