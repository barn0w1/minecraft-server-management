# Install this file as /etc/mcserver/deployment.toml, replace every REPLACE_
# value, and keep it mode 0600. Values under [files] are standard paths on the
# AlmaLinux 10 control-plane host; secret contents never belong in this TOML.

[release]
version = "v0.3.0"
repository = "barn0w1/minecraft-server-management"
target = "x86_64-unknown-linux-musl"
checksums_sha256 = "REPLACE_WITH_SHA256SUMS_DIGEST"
expected_commit = "REPLACE_WITH_FULL_RELEASE_COMMIT"

[service]
public_address = "agent.mcserver.hss-science.org:443"
server_name = "agent.mcserver.hss-science.org"
trust_domain = "hss-science.org"
certbot_lineage = "/etc/letsencrypt/live/agent.mcserver.hss-science.org"
rust_log = "mcserver_control_plane=info,mcserver_protocol=info"

[akamai]
scope = "production"
allowed_regions = ["jp-tyo-3"]
allowed_images = ["linode/debian13"]
allowed_instance_types = ["g6-nanode-1"]
allowed_firewall_ids = [0] # REPLACE_WITH_EXISTING_FIREWALL_ID
max_active_instances = 1
max_instance_lifetime_seconds = 43200

[r2]
account_id = "REPLACE_WITH_32_HEX_ACCOUNT_ID"
parent_access_key_id = "REPLACE_WITH_PARENT_R2_ACCESS_KEY_ID"
bucket = "REPLACE_WITH_DEDICATED_BUCKET"
temporary_credential_ttl_seconds = 46800

[files]
akamai_api_token = "/etc/mcserver/credentials/akamai-api-token"
r2_api_token = "/etc/mcserver/credentials/r2-api-token"
remote_tls_private_key = "/etc/letsencrypt/live/agent.mcserver.hss-science.org/privkey.pem"
agent_client_ca_private_key = "/etc/mcserver/credentials/agent-client-ca-private-key.pem"
r2_runtime_environment = "/etc/mcserver/credentials/r2-runtime.env"
remote_tls_fullchain = "/etc/letsencrypt/live/agent.mcserver.hss-science.org/fullchain.pem"
remote_tls_root_ca = "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"
agent_client_ca_certificate = "/etc/mcserver/pki/agent-client-ca.pem"
authorized_keys = "/etc/mcserver/authorized_keys"

[acceptance]
region = "jp-tyo-3"
image = "linode/debian13"
instance_type = "g6-nanode-1"
firewall_id = 0 # REPLACE_WITH_EXISTING_FIREWALL_ID
host_port = 25565
timeout_seconds = 3600
